// --- Couleur jaune ---
#define JAUNE couleur_RGB(255, 255, 0)

void bouton_quitter()
{
    POINT p1 = { WIDTH - 150, 20 };   // coin haut gauche du bouton
    POINT p2 = { WIDTH - 20, 70 };    // coin bas droit du bouton

    // Rectangle du bouton (rempli)
    draw_fill_rectangle(p1, p2, JAUNE);

    // Texte "Quitter" centré
    char texte[] = "Quitter";
    int taille = 20;
    POINT txt;

    txt.x = p1.x + ( (p2.x - p1.x) - largeur_texte(texte, taille) ) / 2;
    txt.y = p1.y + ( (p2.y - p1.y) - hauteur_texte(texte, taille) ) / 2;

    aff_pol(texte, taille, txt, noir);
    affiche_all();
}

// --- Détection du clic dans le bouton Quitter ---
int clic_sur_quitter(POINT p)
{
    if (p.x >= WIDTH - 150 && p.x <= WIDTH - 20 &&
        p.y >= 20 && p.y <= 70)
    {
        return 1;
    }
    return 0;
}

